# =============================================================================
# Hostel Management System — Backend Environment Configuration Template
# DO NOT put real secrets in this file!
# Copy this file to "backend/.env" and fill in your actual database credentials.
# "backend/.env" is ignored by git and will never be committed.
# =============================================================================

# PostgreSQL / Supabase connection string (Raw SQL via psycopg 3)
# Example for Supabase:
# postgresql://postgres.[project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example for local PostgreSQL:
# postgresql://postgres:your_password@localhost:5432/hostel_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hostel_db

# Custom schema name (always "hostel")
DB_SCHEMA=hostel

# Allowed frontend origins for CORS (React / Vite runs on port 5173 by default)
CORS_ORIGINS=http://localhost:5173

# Server settings
HOST=0.0.0.0
PORT=8000
